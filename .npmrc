# Use lenient peer-dependency resolution.
# @convex-dev/auth@0.0.68 declares an optional peer of react@^18.2.0, which
# conflicts with the project's react@19.1.0 under npm's strict resolver and
# breaks `npm ci` on EAS Build (ERESOLVE). legacy-peer-deps makes npm skip
# that optional peer conflict. The `overrides` in package.json still pin
# react/react-dom to 19.1.0 across the whole tree.
legacy-peer-deps=true

# pnpm: auto-install peers (keeps local pnpm installs consistent with the above)
auto-install-peers=true
